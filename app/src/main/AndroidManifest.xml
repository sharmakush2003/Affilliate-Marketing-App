<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/reward_club_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/reward_club_logo"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.RewardClub">

        <!-- Cuelinks SDK Channel ID Configuration -->
        <meta-data
            android:name="com.cuelinks.channelId"
            android:value="301603" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RewardClub"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link: rewardclub://home  (email verification redirect) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rewardclub" android:host="home" />
            </intent-filter>
            <!-- App Link: https://affilliate-marketing-app.vercel.app/verify-email -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="affilliate-marketing-app.vercel.app"
                    android:pathPrefix="/verify-email" />
            </intent-filter>
        </activity>
    </application>

</manifest>

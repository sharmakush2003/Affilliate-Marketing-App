<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/reward_club_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/reward_club_logo"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.RewardClub">

        <!-- Cuelinks SDK Channel ID Configuration -->
        <meta-data
            android:name="com.cuelinks.channelId"
            android:value="301603" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RewardClub">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
